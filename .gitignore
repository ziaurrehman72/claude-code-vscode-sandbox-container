# =============================================================================
# .gitignore – Files excluded from version control
# =============================================================================
# SECURITY: Prevents sensitive files (secrets, credentials, logs) from
# being accidentally committed – especially relevant when AI agents
# create files or add them to the staging area.
# =============================================================================

# ── Environment Variables & Secrets ───────────────────────────────────────────
.env
.env.*
.env.local
.env.production
.env.staging
*.secret
*.secrets

# ── Private Keys & Certificates ───────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# ── Python ────────────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDE & Editor ──────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ── OS Files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Temporary Files ───────────────────────────────────────────────────────────
tmp/
temp/
*.tmp

# ── Databases (local) ─────────────────────────────────────────────────────────
*.sqlite
*.db
*.sqlite3

# ── Coverage & Test Reports ───────────────────────────────────────────────────
coverage/
htmlcov/
.coverage
*.cover
.pytest_cache/
.nyc_output/
